
# Optional AI providers (never compulsory - local-first)
OPENAI_API_KEY=

# Local AI (agent planner uses this model via Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
AGENT_TIMEOUT_SECONDS=90

# Connector service for the queue-worker
WORKER_URL=http://localhost:8000

# Optional OpenAI-compatible gateway (e.g. Experiential Labs) for the agent planner.
# Leave empty to stay fully local (Ollama) — never commit real keys.
EXPLABS_API_KEY=
EXPLABS_BASE_URL=https://api.experientiallabs.ai/v1
EXPLABS_MODEL=gpt-4o-mini
