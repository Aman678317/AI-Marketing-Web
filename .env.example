# Database / Queue (matches docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_marketing
REDIS_URL=redis://127.0.0.1:6379

# MinIO Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ai-marketing-assets

# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=change_me
NEXTAUTH_URL=http://localhost:3000

# Python connector service (queue-worker target). Use 127.0.0.1 on Windows —
# `localhost` can resolve to ::1 and miss the uvicorn listener.
WORKER_URL=http://127.0.0.1:8000

# Campaign planning fetch timeout (LLM provider chain takes 15-30s)
PLAN_TIMEOUT_MS=120000

# --- OAuth connectors (official APIs only; never commit real secrets) ---
# Meta / Instagram — https://developers.facebook.com/apps
META_CLIENT_ID=
META_CLIENT_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/auth/meta/callback

# Facebook — same Meta app, separate credentials/permissions
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/auth/facebook/callback

# YouTube — https://console.cloud.google.com/apis/credentials
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback

# LinkedIn — https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/linkedin/callback

# Encryption key for OAuth tokens at rest (32+ chars)
ENCRYPTION_KEY=

# Local AI (agent planner, local-first)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
AGENT_TIMEOUT_SECONDS=90

# Optional cloud provider for the planner (Experiential Labs, OpenAI-compatible).
# Leave empty to stay fully local — never commit real keys.
OPENAI_API_KEY=
EXPLABS_API_KEY=
EXPLABS_BASE_URL=https://api.experientiallabs.ai/v1
EXPLABS_MODEL=gpt-4o-mini

# NVIDIA NIM — optional last-resort planner provider (after Ollama and ExLabs)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=openai/gpt-oss-20b
